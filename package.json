{
  "name": "@scanops/browser-sdk",
  "version": "0.1.0-beta.3",
  "description": "Browser QR and 1D barcode scanning SDK with tracking, Web Workers and React component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicalogs/ScanOps.git",
    "directory": "packages/browser-sdk"
  },
  "homepage": "https://github.com/vicalogs/ScanOps#readme",
  "bugs": {
    "url": "https://github.com/vicalogs/ScanOps/issues"
  },
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/scanops.js",
  "module": "./dist/scanops.js",
  "types": "./dist/types/scanops.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/scanops.d.ts",
      "import": "./dist/scanops.js"
    },
    "./react": {
      "types": "./dist/types/scanops-react.d.ts",
      "import": "./dist/scanops-react.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "scanops-assets": "./bin/scanops-assets.mjs"
  },
  "files": [
    "dist",
    "bin",
    "licenses",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "bwip-js": "4.11.4",
    "esbuild": "0.27.3",
    "qr-scanner": "1.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "zxing-wasm": "3.1.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
